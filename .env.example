# Локальное учебное окружение. Скопируйте в .env; настоящий .env не добавляйте в репозиторий.
SECRET_KEY=replace-with-a-long-random-value-before-running
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
DATABASE_NAME=pereplet
DATABASE_USER=pereplet
DATABASE_PASSWORD=local-pereplet-change-me
# Подключение для локальной разработки. В Compose используется внутренний адрес db:5432.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55432
SEED_DEMO=1
